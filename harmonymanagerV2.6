<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>HarmoniX — 音楽ツール</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@300;400;700&family=Space+Mono:wght@400;700&display=swap');

:root {
  --bg: #0a0a0f;
  --panel: #12121a;
  --panel2: #1a1a26;
  --border: #2a2a3e;
  --accent: #e8c547;
  --accent2: #47b8e8;
  --accent3: #e84778;
  --text: #e8e8f0;
  --text-dim: #6a6a8a;
  --white-key: #f0ede5;
  --black-key: #1a1820;
  --app-padding: 24px;
  --panel-padding: 16px;
  --key-height: 192px;
  --key-width: 44px;
  --black-height: 120px;
  --black-width: 28px;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Noto Sans JP', sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

body::before {
  content:'';
  position:fixed; inset:0;
  background-image:
    linear-gradient(rgba(232,197,71,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(232,197,71,0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events:none;
  z-index:0;
}

.app {
  position:relative; z-index:1;
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--app-padding);
}

h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 3rem;
  letter-spacing: 0.15em;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height:1;
}

.subtitle {
  font-size: 0.75rem;
  color: var(--text-dim);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  margin-top: 4px;
  font-family: 'Space Mono', monospace;
}

header {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.tab-bar {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  width: 100%;
  order: 2;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 72px;
  height: 60px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.18s;
  -webkit-tap-highlight-color: transparent;
  padding: 0;
}
.tab svg { display:block; transition: stroke 0.18s, fill 0.18s; }
.tab-label {
  font-family: 'Space Mono', monospace;
  font-size: 0.52rem;
  letter-spacing: 0.06em;
  line-height: 1;
  color: inherit;
}
.tab:hover { border-color: var(--accent); color: var(--accent); }
.tab.active {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--bg);
}
.tab.active svg { stroke: var(--bg) !important; }
.tab.active .tab-icon-metro rect,
.tab.active .tab-icon-metro polygon { fill: var(--bg) !important; stroke: var(--bg) !important; }

.panel { display:none; }
.panel.active { display:block; }

/* ── CONTROLS ── */
.hd-controls {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.ctrl-group {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: var(--panel-padding);
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
  min-width: 160px;
}
.ctrl-label {
  font-size: 0.63rem;
  letter-spacing: 0.22em;
  color: var(--text-dim);
  text-transform: uppercase;
  font-family: 'Space Mono', monospace;
}
.toggle-row { display:flex; gap:6px; }
.toggle-btn {
  flex:1;
  padding: 6px 0;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-dim);
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.73rem;
  font-family: 'Space Mono', monospace;
  transition: all 0.15s;
}
.toggle-btn:hover:not(:disabled) { border-color: var(--accent2); color: var(--accent2); }
.toggle-btn.active { background: var(--accent2); border-color: var(--accent2); color: var(--bg); font-weight:700; }
.toggle-btn:disabled { opacity: 0.25; cursor: default; }

/* ── CHORD DISPLAY ── */
.chord-display {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0 16px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  height: 80px;
  min-height: 80px;
  max-height: 80px;
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
}

.chord-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 3.2rem;
  line-height: 1;
  color: var(--accent);
  width: 140px;
  min-width: 140px;
  max-width: 140px;
  height: 52px;
  min-height: 52px;
  max-height: 52px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: clip;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  text-shadow: 0 0 32px rgba(232,197,71,0.3);
}
.chord-name.no-chord { color: var(--border); }

.chord-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  height: 80px;
  min-height: 80px;
  max-height: 80px;
}

.chord-type {
  font-size: 0.75rem;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
  flex-shrink: 0;
}

.active-notes {
  display: flex;
  gap: 5px;
  flex-wrap: nowrap;
  overflow: hidden;
  flex-shrink: 0;
  align-items: center;
}
.note-pill {
  padding: 2px 6px;
  border-radius: 99px;
  background: rgba(71,184,232,0.12);
  border: 1px solid var(--accent2);
  color: var(--accent2);
  font-family: 'Space Mono', monospace;
  font-size: 0.65rem;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.4;
}

.badge-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.tuning-badge {
  padding: 4px 8px;
  border-radius: 4px;
  background: rgba(232,197,71,0.1);
  border: 1px solid rgba(232,197,71,0.3);
  color: var(--accent);
  font-family: 'Space Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  white-space: nowrap;
  flex-shrink: 0;
}

.root-select {
  background: var(--panel2);
  color: var(--accent);
  border: 1px solid var(--border);
  border-radius: 4px;
  font-family: 'Space Mono', monospace;
  font-size: 0.65rem;
  padding: 2px 4px;
  outline: none;
  cursor: pointer;
}

/* ── OCTAVE NAV BAR ── */
.octave-nav {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}
.oct-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0 14px;
  height: 40px;
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text);
  border-radius: 8px;
  cursor: pointer;
  font-family: 'Space Mono', monospace;
  font-size: 0.75rem;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}
.oct-btn:active { background: var(--panel2); }
.oct-btn:disabled {
  opacity: 0.3;
  cursor: default;
}
.oct-btn.prev { border-color: var(--accent2); color: var(--accent2); }
.oct-btn.next { border-color: var(--accent2); color: var(--accent2); }

.oct-range-label {
  flex: 1;
  text-align: center;
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  color: var(--text-dim);
  letter-spacing: 0.12em;
  line-height: 1.4;
}
.oct-range-label span {
  display: block;
  font-size: 0.58rem;
  color: var(--text-dim);
  opacity: 0.7;
  margin-top: 2px;
}

/* ── KEYBOARD ── */
.keyboard-wrap {
  overflow-x: auto;
  overflow-y: hidden;
  height: calc(var(--key-height) + 16px);
  padding-bottom: 12px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
.keyboard-wrap::-webkit-scrollbar { height: 6px; }
.keyboard-wrap::-webkit-scrollbar-track { background: transparent; }
.keyboard-wrap::-webkit-scrollbar-thumb { background: var(--border); border-radius:3px; }

.keyboard {
  position: relative;
  height: var(--key-height);
  user-select: none;
}

.key.white {
  position: absolute;
  top: 0;
  width: var(--key-width);
  height: var(--key-height);
  background: var(--white-key);
  border-left: 1px solid #c8b898;
  border-right: 1px solid #b0a080;
  border-bottom: 1px solid #a09070;
  border-radius: 0 0 6px 6px;
  z-index: 1;
  cursor: pointer;
  box-shadow: inset -1px 0 0 rgba(255,255,255,0.4), 0 4px 8px rgba(0,0,0,0.3);
}
.key.white:hover   { background: #fffdf5; }
.key.white.pressed { background: #ffe066; box-shadow: inset 0 6px 10px rgba(0,0,0,0.12); }

.key.black {
  position: absolute;
  top: 0;
  width: var(--black-width);
  height: var(--black-height);
  background: var(--black-key);
  border-left: 1px solid #0a0810;
  border-right: 1px solid #0a0810;
  border-bottom: 2px solid #1a1428;
  border-radius: 0 0 4px 4px;
  z-index: 2;
  cursor: pointer;
  box-shadow: 2px 6px 14px rgba(0,0,0,0.75), inset 1px 0 0 rgba(255,255,255,0.04);
}
.key.black:hover   { background: #252030; }
.key.black.pressed { background: #e8c547; box-shadow: 0 0 10px rgba(232,197,71,0.5); }

.key-label {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.54rem;
  font-family: 'Space Mono', monospace;
  color: #9a8a70;
  pointer-events: none;
  white-space: nowrap;
}

.volume-row {
  display:flex; align-items:center; gap:10px; margin-top:10px;
}
.vol-label { font-size:0.63rem; color:var(--text-dim); font-family:'Space Mono',monospace; min-width:36px; }
.vol-slider {
  flex:1; -webkit-appearance:none; height:3px;
  border-radius:2px; background:var(--border); outline:none;
}
.vol-slider::-webkit-slider-thumb {
  -webkit-appearance:none; width:14px; height:14px;
  border-radius:50%; background:var(--accent2); cursor:pointer;
}

/* ── METRONOME ── */
.metro-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media(max-width:700px){ .metro-layout{grid-template-columns:1fr;} }

.metro-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: var(--panel-padding);
}

.metro-display { text-align:center; margin-bottom:8px; }
.bpm-number {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 5.5rem;
  line-height:1;
  color: var(--accent);
  text-shadow: 0 0 40px rgba(232,197,71,0.3);
  transition: color 0.1s;
}
.bpm-unit { font-size:0.72rem; color:var(--text-dim); letter-spacing:0.3em; font-family:'Space Mono',monospace; }

.bpm-slider {
  width:100%; -webkit-appearance:none; height:4px;
  border-radius:2px; background:var(--border); outline:none; margin:10px 0;
}
.bpm-slider::-webkit-slider-thumb {
  -webkit-appearance:none; width:18px; height:18px; border-radius:50%;
  background:var(--accent); cursor:pointer;
}

.metro-btn {
  width:100%; padding:11px; border-radius:8px; border:none;
  font-family:'Bebas Neue',sans-serif; font-size:1.3rem; letter-spacing:0.15em;
  cursor:pointer; transition:all 0.15s;
}
.metro-btn.start { background:var(--accent); color:var(--bg); }
.metro-btn.start:hover { background:#f0d050; }
.metro-btn.start.running { background:var(--accent3); }
.metro-btn.tap {
  background:transparent; border:1px solid var(--accent2);
  color:var(--accent2); margin-top:8px;
}

.beat-visualizer {
  display:flex; gap:6px; justify-content:center;
  margin:10px 0; flex-wrap:wrap; min-height:16px;
}
.beat-dot {
  width:10px; height:10px; border-radius:50%;
  background:var(--border);
}
.beat-dot.beat-main { width:13px; height:13px; }
.beat-dot.lit-main { background:var(--accent); box-shadow:0 0 10px var(--accent); }
.beat-dot.lit-sub  { background:var(--accent2); box-shadow:0 0 7px var(--accent2); }

.pendulum-wrap { display:flex; justify-content:center; margin:4px 0; }
.pendulum-track {
  position:relative; width:120px; height:8px;
  background:var(--border); border-radius:4px;
}
.pendulum-ball {
  position:absolute; top:50%; transform:translate(-50%,-50%);
  width:16px; height:16px; border-radius:50%;
  background:var(--accent); box-shadow:0 0 10px var(--accent);
  left: 50%;
}

.sub-ctrl { margin-top:12px; }
.sub-label { font-size:0.63rem; letter-spacing:0.2em; color:var(--text-dim); font-family:'Space Mono',monospace; text-transform:uppercase; margin-bottom:6px; }
.sub-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:6px; }
.sub-btn {
  padding:6px; border:1px solid var(--border);
  background:transparent; color:var(--text-dim);
  border-radius:6px; cursor:pointer;
  font-family:'Space Mono',monospace; font-size:0.68rem;
  transition:all 0.15s; line-height:1.4;
}
.sub-btn.active { background:rgba(232,71,120,0.15); border-color:var(--accent3); color:var(--accent3); }

.time-sig-grid { display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }
.tsig-btn {
  padding:6px 10px; border:1px solid var(--border);
  background:transparent; color:var(--text-dim);
  border-radius:4px; cursor:pointer;
  font-family:'Space Mono',monospace; font-size:0.73rem;
}
.tsig-btn.active { background:rgba(232,197,71,0.15); border-color:var(--accent); color:var(--accent); }

.section-title { font-size:0.63rem; letter-spacing:0.2em; color:var(--text-dim); font-family:'Space Mono',monospace; text-transform:uppercase; margin-bottom:6px; }

/* ── TUNER ── */
.tuner-layout {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 480px;
  margin: 0 auto;
}

.a-ref-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 16px;
}
.a-ref-label {
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  color: var(--text-dim);
}

.a-spin-btn {
  width: 40px;
  height: 40px;
  border: 1px solid var(--accent);
  background: transparent;
  color: var(--accent);
  font-size: 1.2rem;
  cursor: pointer;
  border-radius: 6px;
}

.a-spin-input {
  width: 64px;
  height: 40px;
  background: transparent;
  border: none;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  color: var(--accent);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.8rem;
  text-align: center;
  outline: none;
}

.tuner-note-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px 16px;
  text-align: center;
}
.tuner-note-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 5rem;
  line-height: 1;
  color: var(--accent);
  min-height: 5rem;
}
.tuner-note-name.in-tune  { color: #44e87a; }
.tuner-note-name.no-input { color: var(--border); }
.tuner-freq-display {
  font-family: 'Space Mono', monospace;
  font-size: 0.9rem;
  color: var(--text-dim);
  min-height: 1.2rem;
}

.cent-meter-wrap {
  margin: 16px auto 0;
  position: relative;
  width: 100%;
}
.cent-track {
  position: relative;
  height: 12px;
  background: var(--panel2);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
}
.cent-fill {
  position: absolute;
  top: 0; bottom: 0;
  width: 4px;
  background: var(--accent);
  left: 50%;
  transform: translateX(-50%);
  transition: left 0.08s ease-out;
}
.cent-fill.in-tune  { background: #44e87a; }
.cent-fill.flat     { background: var(--accent2); }
.cent-fill.sharp    { background: var(--accent3); }
.cent-center-line {
  position: absolute;
  top: -3px; bottom: -3px;
  left: 50%; width: 2px;
  background: rgba(255,255,255,0.25);
}
.cent-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
  font-family: 'Space Mono', monospace;
  font-size: 0.55rem;
  color: var(--text-dim);
}
.cent-value {
  text-align: center;
  font-family: 'Space Mono', monospace;
  font-size: 1rem;
  font-weight: 700;
  margin-top: 8px;
  min-height: 1.4rem;
}
.cent-value.in-tune { color: #44e87a; }
.cent-value.flat    { color: var(--accent2); }
.cent-value.sharp   { color: var(--accent3); }

.tuner-mic-btn {
  width: 100%;
  padding: 11px;
  border-radius: 8px;
  border: 1px solid var(--accent2);
  background: transparent;
  color: var(--accent2);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.2rem;
  letter-spacing: 0.15em;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.tuner-mic-btn.active {
  background: rgba(232,71,120,0.15);
  border-color: var(--accent3);
  color: var(--accent3);
}

.tuner-hint {
  font-size: 0.65rem;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.6;
  font-family: 'Space Mono', monospace;
}

/* ═══════════════════════════════════════════════════
   📱 DEVICE MACHINE AUTO RESPONSIVE OPTIMIZATION
═══════════════════════════════════════════════════ */
/* 💻 Large Screens (Desktops) */
@media (min-width: 1025px) {
  :root {
    --app-padding: 32px;
    --panel-padding: 20px;
    --key-height: 200px;
    --key-width: 46px;
  }
}

/* タブレット端末 (iPad / 各種タブレット) */
@media (max-width: 1024px) and (min-width: 768px) {
  :root {
    --app-padding: 16px;
    --panel-padding: 12px;
    --key-height: 170px;
    --key-width: 38px;
    --black-height: 105px;
    --black-width: 24px;
  }
  h1 { font-size: 2.6rem; }
  .chord-display { height: 74px; min-height: 74px; }
  .chord-name { font-size: 2.8rem; width: 120px; min-width: 120px; }
}

/* スマートフォン端末 (iPhone / Android 縦画面) */
@media (max-width: 767px) {
  :root {
    --app-padding: 10px;
    --panel-padding: 10px;
    --key-height: 150px;
    --key-width: 34px;
    --black-height: 92px;
    --black-width: 20px;
  }
  h1 { font-size: 2.2rem; }
  .subtitle { font-size: 0.65rem; letter-spacing: 0.2em; }
  header { margin-bottom: 12px; padding-bottom: 10px; gap: 8px; }
  .tab { height: 52px; width: 64px; border-radius: 8px; }
  .tab-label { font-size: 0.5rem; letter-spacing: 0; }
  .hd-controls { gap: 6px; margin-bottom: 10px; }
  .ctrl-group { min-width: 140px; padding: 8px; gap: 4px; }
  .toggle-btn { padding: 5px 0; font-size: 0.68rem; }
  .chord-display { height: 68px; min-height: 68px; padding: 0 10px; margin-bottom: 10px; gap: 8px; }
  .chord-name { font-size: 2.3rem; width: 95px; min-width: 95px; height: 42px; min-height: 42px; }
  .chord-type { font-size: 0.68rem; }
  .note-pill { font-size: 0.58rem; padding: 1px 4px; }
  .tuning-badge { font-size: 0.55rem; padding: 2px 6px; }
  .octave-nav { margin-bottom: 6px; }
  .oct-btn { height: 36px; padding: 0 10px; font-size: 0.7rem; border-radius: 6px; }
  .bpm-number { font-size: 4.5rem; }
  .tuner-note-name { font-size: 4rem; min-height: 4rem; }
}
</style>
</head>
<body>
<div class="app">
  <header>
    <div>
      <h1>HarmoniX</h1>
