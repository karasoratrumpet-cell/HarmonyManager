<script>
'use strict';

// ═══════════════════════════════════════════════════
// AUDIO CONTEXT
// ═══════════════════════════════════════════════════
const AC = new (window.AudioContext || window.webkitAudioContext)();
const masterGain = AC.createGain(); masterGain.gain.value = 0.5; masterGain.connect(AC.destination);
const metroGain  = AC.createGain(); metroGain.gain.value  = 0.7; metroGain.connect(AC.destination);
const subGain    = AC.createGain(); subGain.gain.value    = 0.7; subGain.connect(AC.destination);
function setVolume(v)   { masterGain.gain.value = parseFloat(v); }
function setMetroVol(v) { metroGain.gain.value  = parseFloat(v); }
function setSubVol(v)   { subGain.gain.value    = parseFloat(v); }

// ═══════════════════════════════════════════════════
// TUNING & CHROMATIC KEY DATA
// ═══════════════════════════════════════════════════
let tuning = 'equal';
let timbre = 'sine';
let autoRecognize = true; 
let currentRoot = 0; // 0=C, 1=D♭ ... 11=B
let currentRootOctave = 4; // 主音の基準オクターブを動的に保持
let A4_FREQ = 442;
let tunerA4 = 442;

const JUST = [1, 16/15, 9/8, 6/5, 5/4, 4/3, 45/32, 3/2, 8/5, 5/3, 9/5, 15/8];

function noteToFreq(semitone) {
  if (tuning === 'equal') {
    return A4_FREQ * Math.pow(2, (semitone - 9) / 12);
  }

  // 純正律の計算ロジック
  const notePitchClass = ((semitone % 12) + 12) % 12;
  const intervalFromRoot = (notePitchClass - currentRoot + 12) % 12;
  
  // 割り出された主音の絶対ノート番号（オクターブ考慮）を計算
  const rootSemitone = (currentRootOctave - 4) * 12 + currentRoot;
  
  // 平均律における主音の周波数をアンカー（基準）にする
  const rootEqualFreq = A4_FREQ * Math.pow(2, (rootSemitone - 9) / 12);
  
  // 主音から数えた純正律の周波数を算出
  let targetFreq = rootEqualFreq * JUST[intervalFromRoot];
  
  // 弾いている音が、基準オクターブの主音より音高クラスとして手前にある場合のオクターブ補正
  if (notePitchClass < currentRoot) {
    targetFreq *= 2;
  }

  // 実際のノート番号と、基準とした主音ノート番号との間の「物理的なオクターブ差」を求めて乗算
  const physicalOctaveDiff = Math.floor(semitone / 12) - Math.floor(rootSemitone / 12);
  targetFreq *= Math.pow(2, physicalOctaveDiff);

  return targetFreq;
}

// ═══════════════════════════════════════════════════
// NOTE PLAYBACK
// ═══════════════════════════════════════════════════
const activeOscs = {};

function playNote(semitone) {
  if (activeOscs[semitone]) return;
  AC.resume();
  const freq = noteToFreq(semitone);
  const gainNode = AC.createGain();
  gainNode.gain.setValueAtTime(0, AC.currentTime);
  gainNode.gain.linearRampToValueAtTime(0.22, AC.currentTime + 0.015);
  gainNode.connect(masterGain);

  const oscList = [];

  if (timbre === 'sine') {
    const o1 = AC.createOscillator(); o1.type = 'sine'; o1.frequency.value = freq;
    const o2 = AC.createOscillator(); o2.type = 'sine'; o2.frequency.value = freq * 2;
    const g2 = AC.createGain(); g2.gain.value = 0.1;
    o1.connect(gainNode); o2.connect(g2); g2.connect(gainNode);
    o1.start(); o2.start(); oscList.push(o1, o2);
  } else {
    [1,3,5,7].forEach((h,i) => {
      const o = AC.createOscillator(); o.type = 'sine'; o.frequency.value = freq * h;
      const g = AC.createGain(); g.gain.value = [0.55,0.35,0.12,0.04][i];
      o.connect(g); g.connect(gainNode); o.start(); oscList.push(o);
    });
  }

  activeOscs[semitone] = { oscList, gainNode };
}

function stopNote(semitone) {
  if (!activeOscs[semitone]) return;
  const { oscList, gainNode } = activeOscs[semitone];
  const t = AC.currentTime;
  gainNode.gain.setValueAtTime(gainNode.gain.value, t);
  gainNode.gain.exponentialRampToValueAtTime(0.001, t + 0.25);
  oscList.forEach(o => { try { o.stop(t + 0.28); } catch(e){} });
  delete activeOscs[semitone];
}

function retuneActiveNotes() {
  Object.keys(activeOscs).forEach(semitone => {
    const s = parseInt(semitone);
    const newFreq = noteToFreq(s);
    activeOscs[s].oscList.forEach((osc, idx) => {
      const harmonicMultiplier = timbre === 'sine' ? (idx + 1) : [1,3,5,7][idx];
      osc.frequency.setValueAtTime(newFreq * harmonicMultiplier, AC.currentTime);
    });
  });
}

// ═══════════════════════════════════════════════════
// KEYBOARD BUILD
// ═══════════════════════════════════════════════════
const NOTE_NAMES   = ['C','D♭','D','E♭','E','F','G♭','G','A♭','A','B♭','B'];
const WHITE_DEG    = [0,2,4,5,7,9,11];
const BLACK_AFTER  = [1,3,null,6,8,10,null];

const KW = 44;
const KG = 2;
const KB_W = 28;

const OCT_MIN = 1;
const OCT_MAX = 7;
const OCT_SPAN = 3;
let octLo = 3;

function octHi() { return octLo + OCT_SPAN - 1; }

function shiftOctave(delta) {
  const newLo = octLo + delta;
  if (newLo < OCT_MIN || newLo + OCT_SPAN - 1 > OCT_MAX) return;
  [...pressedNotes].forEach(s => endNote(s));
  octLo = newLo;
  buildKeyboard();
  updateOctaveNav();
  document.querySelector('.keyboard-wrap').scrollLeft = 0;
}

function updateOctaveNav() {
  const hi = octHi();
  document.getElementById('oct-range-label').innerHTML =
    `C${octLo} 〜 B${hi}<span>表示中の音域</span>`;
  document.getElementById('oct-prev').disabled = (octLo <= OCT_MIN);
  document.getElementById('oct-next').disabled = (octHi() >= OCT_MAX);
}

function buildKeyboard() {
  const kb = document.getElementById('keyboard');
  kb.innerHTML = '';
  let wi = 0;

  for (let oct = octLo; oct <= octHi(); oct++) {
    for (let pos = 0; pos < WHITE_DEG.length; pos++) {
      const degree   = WHITE_DEG[pos];
      const semitone = (oct - 4) * 12 + degree;

      const wk = document.createElement('div');
      wk.className = 'key white';
      wk.dataset.semitone = semitone;
      wk.style.left = `calc(${wi} * (var(--key-width) + 2px))`;

      if (degree === 0) {
        const lbl = document.createElement('div');
        lbl.className = 'key-label';
        lbl.textContent = 'C' + oct;
        wk.appendChild(lbl);
      }

      addKeyEvents(wk, semitone);
      kb.appendChild(wk);

      const bd = BLACK_AFTER[pos];
      if (bd !== null) {
        const bs = (oct - 4) * 12 + bd;
        const bk = document.createElement('div');
        bk.className = 'key black';
        bk.dataset.semitone = bs;
        bk.style.left = `calc(${wi} * (var(--key-width) + 2px) + var(--key-width) - var(--black-width) / 2 + 1px)`;
        addKeyEvents(bk, bs);
        kb.appendChild(bk);
      }

      wi++;
    }
  }
  kb.style.width = `calc(${wi} * (var(--key-width) + 2px))`;
}

function addKeyEvents(el, semitone) {
  el.addEventListener('mousedown',  e => { e.preventDefault(); startNote(semitone); });
  el.addEventListener('mouseup',    ()=> endNote(semitone));
  el.addEventListener('mouseleave', ()=> { if (el.classList.contains('pressed')) endNote(semitone); });
  el.addEventListener('touchstart', e => { e.preventDefault(); startNote(semitone); }, {passive:false});
  el.addEventListener('touchend',   e => { e.preventDefault(); endNote(semitone); });
  el.addEventListener('touchcancel',e => { e.preventDefault(); endNote(semitone); });
}

const pressedNotes = new Set();

function startNote(s) {
  if (pressedNotes.has(s)) return;
  pressedNotes.add(s);
  
  if (tuning === 'just' && autoRecognize) {
    determineAutoRoot();
  }
  
  playNote(s);
  document.querySelectorAll(`.key[data-semitone="${s}"]`).forEach(k => k.classList.add('pressed'));
  updateChord();
}

function endNote(s) {
  if (!pressedNotes.has(s)) return;
  pressedNotes.delete(s);
  stopNote(s);
  document.querySelectorAll(`.key[data-semitone="${s}"]`).forEach(k => k.classList.remove('pressed'));
  
  if (tuning === 'just' && autoRecognize && pressedNotes.size > 0) {
    determineAutoRoot();
  }
  
  updateChord();
}

// ═══════════════════════════════════════════════════
// CHORD DETECTION & AUTO ROOT SELECTION (FIXED)
// ═══════════════════════════════════════════════════
const CHORD_TYPES = [
  {name:'',     iv:[0,4,7],      label:'メジャー'},
  {name:'m',    iv:[0,3,7],      label:'マイナー'},
  {name:'7',    iv:[0,4,7,10],   label:'ドミナント7th'},
  {name:'M7',   iv:[0,4,7,11],   label:'メジャー7th'},
  {name:'m7',   iv:[0,3,7,10],   label:'マイナー7th'},
  {name:'mM7',  iv:[0,3,7,11],   label:'マイナーメジャー7th'},
  {name:'dim',  iv:[0,3,6],      label:'ディミニッシュ'},
  {name:'dim7', iv:[0,3,6,9],    label:'ディミニッシュ7th'},
  {name:'aug',  iv:[0,4,8],      label:'オーギュメント'},
  {name:'sus2', iv:[0,2,7],      label:'サスペンデッド2nd'},
  {name:'sus4', iv:[0,5,7],      label:'サスペンデッド4th'},
  {name:'6',    iv:[0,4,7,9],    label:'メジャー6th'},
  {name:'m6',   iv:[0,3,7,9],    label:'マイナー6th'},
  {name:'add9', iv:[0,2,4,7],    label:'アドナインス'},
  {name:'9',    iv:[0,2,4,7,10], label:'ナインス'},
  {name:'5',    iv:[0,7],        label:'パワーコード'},
];

function determineAutoRoot() {
  const pressed = [...pressedNotes].sort((a,b)=>a-b);
  if (pressed.length === 0) return;
  
  const pcs = [...new Set(pressed.map(s => ((s%12)+12)%12))].sort((a,b)=>a-b);
  
  let detectedRootPC = null;

  if (pcs.length === 1) {
    detectedRootPC = pcs[0];
  } else {
    // コード分析による主音(Root)の割り出し
    let found = false;
    for (const root of pcs) {
      const ivs = pcs.map(n => ((n-root)+12)%12).sort((a,b)=>a-b);
      for (const ct of CHORD_TYPES) {
        const ci = ct.iv.map(i=>i%12).sort((a,b)=>a-b);
        if (ivs.length === ci.length && ivs.every((v,i)=>v===ci[i])) {
          detectedRootPC = root;
          found = true;
          break;
        }
      }
      if (found) break;
    }
    // 不明なコードの場合は一番低い構成音を主音クラスとする
    if (detectedRootPC === null) {
      detectedRootPC = ((pressed[0]%12)+12)%12;
    }
  }

  // 🎯 【オクターブズレ修正の核心】
  // 実際に押されている鍵盤の「絶対ノート番号」から、割り出された主音(PC)に最も合致する実オクターブ位置を決定する
  if (detectedRootPC !== null) {
    // 押されているキーの中から、主音PCと完全に一致するノートを探す
    const matchingNote = pressed.find(s => ((s%12)+12)%12 === detectedRootPC);
    
    if (matchingNote !== undefined) {
      // 押された和音の中に主音そのものが含まれる場合は、そのオクターブを基準にする
      currentRootOctave = Math.floor(matchingNote / 12) + 4;
    } else {
      // 展開形などで主音そのものが省かれている場合、一番低い音のオクターブをベースにする
      currentRootOctave = Math.floor(pressed[0] / 12) + 4;
    }
    
    if (currentRoot !== detectedRootPC) {
      currentRoot = detectedRootPC;
    }
    retuneActiveNotes();
  }
}

function updateChord() {
  const nameEl = document.getElementById('chord-name');
  const typeEl = document.getElementById('chord-type');
  const notesEl = document.getElementById('active-notes-display');
  const selectEl = document.getElementById('manual-root-select');

  const pressed = [...pressedNotes].sort((a,b)=>a-b);
  notesEl.innerHTML = pressed.map(s => {
    const octave = Math.floor(s/12) + 4;
    return `<span class="note-pill">${NOTE_NAMES[((s%12)+12)%12]}${octave}</span>`;
  }).join('');

  const pcs = [...new Set(pressed.map(s => ((s%12)+12)%12))].sort((a,b)=>a-b);

  if (tuning === 'just' && autoRecognize) {
    selectEl.value = currentRoot;
  }

  if (pcs.length === 0) {
    nameEl.textContent = '—'; nameEl.className = 'chord-name no-chord';
    typeEl.textContent = '鍵盤を押してください'; return;
  }
  if (pcs.length === 1) {
    nameEl.textContent = NOTE_NAMES[pcs[0]]; nameEl.className = 'chord-name';
    typeEl.textContent = '単音' + (tuning === 'just' ? ` (主音: ${NOTE_NAMES[currentRoot]}${currentRootOctave})` : ''); return;
  }

  let best = null;
  for (const root of pcs) {
    const ivs = pcs.map(n => ((n-root)+12)%12).sort((a,b)=>a-b);
    for (const ct of CHORD_TYPES) {
      const ci = ct.iv.map(i=>i%12).sort((a,b)=>a-b);
      if (ivs.length===ci.length && ivs.every((v,i)=>v===ci[i])) { best={root,ct}; break; }
    }
    if (best) break;
  }

  if (best) {
    nameEl.textContent = NOTE_NAMES[best.root] + best.ct.name;
    nameEl.className = 'chord-name';
    typeEl.textContent = best.ct.label + (tuning === 'just' ? ` (主音: ${NOTE_NAMES[currentRoot]}${currentRootOctave})` : '');
  } else {
    nameEl.textContent = '?'; nameEl.className = 'chord-name';
    typeEl.textContent = '不明なコード' + (tuning === 'just' ? ` (主音: ${NOTE_NAMES[currentRoot]}${currentRootOctave})` : '');
  }
}

// ═══════════════════════════════════════════════════
// SETTINGS & CONFIG
// ═══════════════════════════════════════════════════
function setTuning(t) {
  tuning = t;
  document.getElementById('btn-equal').classList.toggle('active', t==='equal');
  document.getElementById('btn-just').classList.toggle('active',  t==='just');
  
  const isJust = (t === 'just');
  document.getElementById('btn-auto-on').disabled = !isJust;
  document.getElementById('btn-auto-off').disabled = !isJust;
  
  const selectEl = document.getElementById('manual-root-select');
  
  if (isJust) {
    document.getElementById('tuning-badge').textContent = '純正律';
    setAutoRecognize(autoRecognize);
  } else {
    document.getElementById('tuning-badge').textContent = '平均律';
    selectEl.style.display = 'none';
  }
  
  if (isJust && autoRecognize) {
    determineAutoRoot();
  }
  retuneActiveNotes();
  updateChord();
}

function setAutoRecognize(on) {
  autoRecognize = on;
  document.getElementById('btn-auto-on').classList.toggle('active', on);
  document.getElementById('btn-auto-off').classList.toggle('active', !on);
  
  const selectEl = document.getElementById('manual-root-select');
  if (tuning === 'just') {
    if (on) {
      document.getElementById('tuning-badge').textContent = '純正律:自動';
      selectEl.style.display = 'none';
      determineAutoRoot();
    } else {
      document.getElementById('tuning-badge').textContent = '純正律:固定';
      selectEl.style.display = 'inline-block';
      selectEl.value = currentRoot;
      currentRootOctave = 4; // 固定時は基準オクターブを4(中央)にデフォルト化
    }
    retuneActiveNotes();
    updateChord();
  }
}

function setManualRoot(rootValue) {
  if (tuning === 'just' && !autoRecognize) {
    currentRoot = rootValue;
    currentRootOctave = 4;
    retuneActiveNotes();
    updateChord();
  }
}

function setTimbre(t) {
  timbre = t;
  document.getElementById('btn-sine').classList.toggle('active', t==='sine');
  document.getElementById('btn-wind').classList.toggle('active', t==='wind');
  Object.keys(activeOscs).forEach(s => { stopNote(s); playNote(s); });
}

// ═══════════════════════════════════════════════════
// PC KEYBOARD
// ═══════════════════════════════════════════════════
const KEY_MAP = {
  'a':0,'w':1,'s':2,'e':3,'d':4,'f':5,'t':6,'g':7,'y':8,'h':9,'u':10,'j':11,
  'k':12,'o':13,'l':14,'p':15,';':16
};
const heldKeys = new Set();
document.addEventListener('keydown', e => {
  if (e.repeat || e.target.tagName==='INPUT' || e.target.tagName==='SELECT') return;
  const k = e.key.toLowerCase();
  if (k in KEY_MAP && !heldKeys.has(k)) { heldKeys.add(k); startNote(KEY_MAP[k]); }
});
document.addEventListener('keyup', e => {
  const k = e.key.toLowerCase();
  if (k in KEY_MAP && heldKeys.has(k)) { heldKeys.delete(k); endNote(KEY_MAP[k]); }
});

// ═══════════════════════════════════════════════════
// METRONOME
// ═══════════════════════════════════════════════════
let bpm        = 120;
let timeSig    = 4;
let subDiv     = 'none';
let metroRun   = false;

let schedBeat  = 0;
let schedSub   = 0;
let nextTime   = 0;
let schTimer   = null;

const LOOK_AHEAD = 0.15;
const SCHED_MS   = 20;
const SUB_COUNT  = {none:1,'8th':2,'16th':4,triplet:3};

function subSec() { return (60/bpm) / SUB_COUNT[subDiv]; }

function schedClick(time, isAccent, isSub) {
  const osc = AC.createOscillator();
  const g   = AC.createGain();
  const dest = isSub ? subGain : metroGain;
  osc.connect(g); g.connect(dest);
  let freq = isAccent ? 1400 : (isSub ? 700 : 900);
  let amp  = isAccent ? 0.9  : (isSub ? 0.5 : 0.65);
  let dur  = isAccent ? 0.07 : 0.05;
  osc.frequency.value = freq;
  g.gain.setValueAtTime(0, time);
  g.gain.linearRampToValueAtTime(amp, time + 0.002);
  g.gain.exponentialRampToValueAtTime(0.001, time + dur);
  osc.start(time);
  osc.stop(time + dur + 0.005);
}

function scheduler() {
  if (!metroRun) return;
  const sc = SUB_COUNT[subDiv];
  const ss = subSec();
  const measureSec = timeSig * (60/bpm);

  while (nextTime < AC.currentTime + LOOK_AHEAD) {
    const isAccent = (schedBeat===0 && schedSub===0);
    const isSub    = (schedSub!==0);

    schedClick(nextTime, isAccent, isSub);

    const visDelay = Math.max(0, (nextTime - AC.currentTime)*1000);
    const swingNow = isAccent;
    const swingDir = pendulumStep;
    if (swingNow) pendulumStep = 1 - pendulumStep;

    ;((beat,sub,acc,swing,dir,msec)=>{
      setTimeout(()=>{
        if (!metroRun) return;
        flashDot(beat,sub,acc);
        if (swing) movePendulum(dir, msec);
      }, visDelay);
    })(schedBeat, schedSub, isAccent, swingNow, swingDir, measureSec);

    nextTime += ss;
    schedSub++;
    if (schedSub >= sc) { schedSub=0; schedBeat=(schedBeat+1)%timeSig; }
  }

  schTimer = setTimeout(scheduler, SCHED_MS);
}

function flashDot(beat, sub, isAccent) {
  document.querySelectorAll('.beat-dot').forEach(d=>d.classList.remove('lit-main','lit-sub'));
  const dot = document.getElementById(`dot-${beat}-${sub}`);
  if (!dot) return;
  dot.classList.add(isAccent?'lit-main':(sub===0?'lit-main':'lit-sub'));
  setTimeout(()=>dot.classList.remove('lit-main','lit-sub'), 100);
}

let pendulumStep = 0;

function movePendulum(dir, measureSec) {
  const ball = document.getElementById('pendulum-ball');
  if(!ball) return;
  const toPct = dir === 0 ? 92 : 8;
  const dur = Math.max(0.1, measureSec * 0.96);
  ball.style.transition = `left ${dur.toFixed(3)}s ease-in-out`;
  ball.style.left = toPct + '%';
}

function toggleMetro() {
  AC.resume();
  metroRun = !metroRun;
  const btn = document.getElementById('metro-start');
  if (metroRun) {
    btn.textContent = '■ ストップ'; btn.classList.add('running');
    schedBeat=0; schedSub=0; pendulumStep=0;
    const ball = document.getElementById('pendulum-ball');
    ball.style.transition = 'none';
    ball.style.left = '8%';
    nextTime = AC.currentTime + 0.05;
    clearTimeout(schTimer);
    scheduler();
  } else {
    btn.textContent = '▶ スタート'; btn.classList.remove('running');
    clearTimeout(schTimer);
    const ball = document.getElementById('pendulum-ball');
    if(ball) {
      ball.style.transition = 'left 0.4s ease';
      ball.style.left = '50%';
    }
  }
}

function setBPM(v) {
  bpm = Math.max(40,Math.min(240,parseInt(v)));
  document.getElementById('bpm-display').textContent = bpm;
  document.getElementById('bpm-slider').value = bpm;
}

function setTimeSig(n, el) {
  timeSig = n;
  document.querySelectorAll('.tsig-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  schedBeat=0; schedSub=0;
  updateBeatViz();
}

function setSubDiv(s, el) {
  subDiv = s;
  document.querySelectorAll('.sub-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  schedBeat=0; schedSub=0;
  updateBeatViz();
}

function updateBeatViz() {
  const viz = document.getElementById('beat-viz');
  viz.innerHTML = '';
  const sc = SUB_COUNT[subDiv];
  for (let b=0; b<timeSig; b++) {
    for (let s=0; s<sc; s++) {
      const d = document.createElement('div');
      d.className = 'beat-dot' + (s===0?' beat-main':'');
      d.id = `dot-${b}-${s}`;
      viz.appendChild(d);
    }
  }
}

let tapTimes=[], tapReset=null;
function tapTempo() {
  AC.resume();
  const now = performance.now();
  tapTimes.push(now);
  clearTimeout(tapReset);
  tapReset = setTimeout(()=>{tapTimes=[];}, 2000);
  if (tapTimes.length>=2) {
    let sum=0;
    for(let i=1;i<tapTimes.length;i++) sum+=tapTimes[i]-tapTimes[i-1];
    setBPM(Math.round(60000/(sum/(tapTimes.length-1))));
  }
  const d=document.getElementById('bpm-display');
  d.style.color='#47b8e8';
  setTimeout(()=>d.style.color='',140);
}

function switchTab(name, el) {
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('panel-'+name).classList.add('active');
  el.classList.add('active');
  if (name !== 'tuner' && tunerRunning) stopTuner();
}

// ═══════════════════════════════════════════════════
// TUNER
// ═══════════════════════════════════════════════════
let tunerRunning  = false;
let tunerStream   = null;
let tunerSource   = null;
let tunerAnalyser = null;
let tunerRAF      = null;

const TUNER_NOTE_NAMES = ['C','D♭','D','E♭','E','F','G♭','G','A♭','A','B♭','B'];

function setA4(hz) {
  hz = parseInt(hz);
  if (isNaN(hz)) return;
  hz = Math.max(415, Math.min(470, hz));
  tunerA4 = hz;
  A4_FREQ = hz;

  const d1 = document.getElementById('a4-display');
  const d2 = document.getElementById('a4-display-harmony');
  if (d1 && d1.value != hz) d1.value = hz;
  if (d2 && d2.value != hz) d2.value = hz;

  retuneActiveNotes();
}

async function toggleTuner() {
  if (tunerRunning) { stopTuner(); return; }

  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    alert('このブラウザはマイク入力に対応していません。\nChrome / Safari の最新版をお使いください。');
    return;
  }

  try {
    await AC.resume();
    tunerStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
  } catch(e) {
    let msg = 'マイクへのアクセスができませんでした。\n';
    if (e.name === 'NotAllowedError' || e.name === 'PermissionDeniedError')
      msg += 'ブラウザのマイク許可を「許可」に設定してください。';
    else if (e.name === 'NotFoundError')
      msg += 'マイクが見つかりません。デバイスを確認してください。';
    else
      msg += '(' + e.name + ') ' + e.message;
    alert(msg);
    return;
  }

  if (AC.state === 'suspended') {
    await AC.resume();
  }

  tunerAnalyser = AC.createAnalyser();
  tunerAnalyser.fftSize = 2048;
  tunerAnalyser.smoothingTimeConstant = 0;
  tunerSource = AC.createMediaStreamSource(tunerStream);
  tunerSource.connect(tunerAnalyser);

  tunerRunning = true;
  const btn = document.getElementById('tuner-mic-btn');
  btn.classList.add('active');
  btn.innerHTML = `<svg width="18" height="20" viewBox="0 0 18 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="5" y="1" width="8" height="11" rx="4"/><path d="M2,10 Q2,16 9,16 Q16,16 16,10"/><line x1="9" y1="16" x2="9" y2="19"/><line x1="6" y1="19" x2="12" y2="19"/></svg> マイクをオフにする`;
  tunerRAF = requestAnimationFrame(detectPitch);
}

function stopTuner() {
  tunerRunning = false;
  cancelAnimationFrame(tunerRAF);
  if (tunerStream)  tunerStream.getTracks().forEach(t => t.stop());
  if (tunerSource)  { try { tunerSource.disconnect(); } catch(e){} }
  tunerStream = tunerSource = tunerAnalyser = null;
  const btn = document.getElementById('tuner-mic-btn');
  if (btn) {
    btn.classList.remove('active');
    btn.innerHTML = `<svg width="18" height="20" viewBox="0 0 18 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="5" y="1" width="8" height="11" rx="4"/><path d="M2,10 Q2,16 9,16 Q16,16 16,10"/><line x1="9" y1="16" x2="9" y2="19"/><line x1="6" y1="19" x2="12" y2="19"/></svg> マイクをオンにする`;
  }
  resetTunerUI();
}

function resetTunerUI() {
  const noteEl = document.getElementById('tuner-note');
  const freqEl = document.getElementById('tuner-freq');
  const centEl = document.getElementById('cent-value');
  const fillEl = document.getElementById('cent-fill');
  if (noteEl) { noteEl.textContent = '—'; noteEl.className = 'tuner-note-name no-input'; }
  if (freqEl) freqEl.textContent = '';
  if (centEl) { centEl.textContent = ''; centEl.className = 'cent-value'; }
  if (fillEl) { fillEl.style.left = '50%'; fillEl.className = 'cent-fill'; }
}

let pitchBuf = null;

function detectPitch() {
  if (!tunerRunning || !tunerAnalyser) return;
  tunerRAF = requestAnimationFrame(detectPitch);

  const bufSize = tunerAnalyser.fftSize;
  if (!pitchBuf || pitchBuf.length !== bufSize) pitchBuf = new Float32Array(bufSize);
  tunerAnalyser.getFloatTimeDomainData(pitchBuf);

  let rms = 0;
  for (let i = 0; i < bufSize; i++) rms += pitchBuf[i] * pitchBuf[i];
  rms = Math.sqrt(rms / bufSize);
  if (rms < 0.01) { resetTunerUI(); return; }

  const freq = yinPitch(pitchBuf, AC.sampleRate);
  if (!freq || freq < 50 || freq > 2000) { resetTunerUI(); return; }

  const semisFromA4 = 12 * Math.log2(freq / tunerA4);
  const nearestSemi = Math.round(semisFromA4);
  const cents       = (semisFromA4 - nearestSemi) * 100;

  const semiFromC4 = nearestSemi + 9;
  const octave     = Math.floor(semiFromC4 / 12) + 4;
  const degree     = ((semiFromC4 % 12) + 12) % 12;
  const noteName   = TUNER_NOTE_NAMES[degree] + octave;

  const absCents = Math.abs(cents);
  const state    = absCents <= 5 ? 'in-tune' : (cents < 0 ? 'flat' : 'sharp');

  const noteEl = document.getElementById('tuner-note');
  const freqEl = document.getElementById('tuner-freq');
  const centEl = document.getElementById('cent-value');
  const fillEl = document.getElementById('cent-fill');

  noteEl.textContent = noteName;
  noteEl.className   = 'tuner-note-name' + (state === 'in-tune' ? ' in-tune' : '');
  freqEl.textContent = freq.toFixed(1) + ' Hz';
  const sign = cents >= 0 ? '+' : '';
  centEl.textContent = sign + cents.toFixed(1) + '¢';
  centEl.className   = 'cent-value ' + state;
  fillEl.className   = 'cent-fill ' + state;
  const pct = 50 + (cents / 50) * 50;
  fillEl.style.left  = Math.max(2, Math.min(98, pct)) + '%';
}

function yinPitch(buf, sampleRate) {
  const N   = buf.length;
  const W   = Math.floor(N / 2);
  const minLag   = Math.floor(sampleRate / 2000);
  const maxLag   = Math.min(W - 1, Math.floor(sampleRate / 50));
  const threshold = 0.10;

  const d = new Float32Array(maxLag + 1);
  for (let tau = 1; tau <= maxLag; tau++) {
    for (let j = 0; j < W; j++) {
      const diff = buf[j] - buf[j + tau];
      d[tau] += diff * diff;
    }
  }

  const cmnd = new Float32Array(maxLag + 1);
  cmnd[0] = 1;
  let runSum = 0;
  for (let tau = 1; tau <= maxLag; tau++) {
    runSum += d[tau];
    cmnd[tau] = runSum > 0 ? (d[tau] * tau / runSum) : 1;
  }

  let tau = -1;
  for (let t = minLag; t <= maxLag; t++) {
    if (cmnd[t] < threshold) {
      while (t + 1 <= maxLag && cmnd[t + 1] < cmnd[t]) t++;
      tau = t;
      break;
    }
  }
  if (tau < 0) return null;

  const x0 = tau > 1 ? tau - 1 : tau;
  const x2 = tau < maxLag ? tau + 1 : tau;
  let betterTau;
  if (x0 === tau)      betterTau = cmnd[tau] <= cmnd[x2] ? tau : x2;
  else if (x2 === tau) betterTau = cmnd[tau] <= cmnd[x0] ? tau : x0;
  else {
    const s0 = cmnd[x0], s1 = cmnd[tau], s2 = cmnd[x2];
    const denom = 2 * s1 - s2 - s0;
    betterTau = denom !== 0 ? tau + (s2 - s0) / (2 * denom) : tau;
  }

  return sampleRate / betterTau;
}

// ── Init ──
buildKeyboard();
updateOctaveNav();
updateBeatViz();
setA4(442);
setAutoRecognize(true);
</script>
